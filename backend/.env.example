# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/naivolt

# Auth
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=30d

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Paystack (Nigerian bank payouts)
PAYSTACK_SECRET_KEY=sk_live_your_key_here

# Admin seed account
ADMIN_EMAIL=admin@naivolt.com
ADMIN_PASSWORD=ChangeMe@1234

# CORS (comma-separated, leave empty to allow all origins)
ALLOWED_ORIGINS=

# Prestmit Gift Card Exchange API (https://prestmit.io/developers)
PRESTMIT_API_KEY=
PRESTMIT_API_SECRET=
PRESTMIT_WEBHOOK_SECRET=
# Set to true to use sandbox (dev-api.prestmit.io) instead of live
PRESTMIT_SANDBOX=true
