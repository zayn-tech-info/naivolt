# Naivolt app — environment
#
# Copy to `.env` for local development. Everything here is EXPO_PUBLIC_*, which
# means Metro inlines it into the JS bundle at build time — it is visible to
# anyone who unpacks the app. Never put a secret in this file.
#
# These must be referenced statically in code (`process.env.EXPO_PUBLIC_X`).
# A dynamic `process.env[name]` lookup is NOT inlined and silently reads as
# undefined — see src/constants/features.ts.

# ── Required ────────────────────────────────────────────────────────
# Base URL of the Rust API. Auth (OTP sign-in) has no fixture, so the app
# cannot get past the sign-in screen without this pointing at a running server.
#
#   iOS simulator      → http://localhost:8000   (shares the host network)
#   Android emulator   → http://10.0.2.2:8000    (alias for the host loopback)
#   Physical device    → http://<your-LAN-IP>:8000
#
# The API's own BIND_ADDR defaults to 0.0.0.0:5000 — but 5000 is taken by
# macOS AirPlay Receiver, which answers 403 to everything, so run it on 8000
# (backend-rs/.env.local sets this).
EXPO_PUBLIC_API_URL=http://localhost:8000

# ── Optional: feature flags ─────────────────────────────────────────
# Serve balances, rates, gift cards and payouts from the in-memory fixture
# instead of the API. Defaults to true in development, false in any release
# build. Leave unset unless you want to override that.
# EXPO_PUBLIC_USE_MOCK_EXCHANGE=true

# Show the v2 custodial surfaces. Defaults to true.
# EXPO_PUBLIC_FEATURE_EXCHANGE_V2=true

# ── Optional: pricing ───────────────────────────────────────────────
# Naira per US dollar, before margin. Tracks the parallel market, not the
# official rate. Defaults to 1530.
# EXPO_PUBLIC_USD_NGN_RATE=1530

# Our margin in naira per dollar of value. ~0.65% at a 1530 mid; use 20 for the
# 1.3% target in ARCHITECTURE.md §9. Defaults to 10.
# EXPO_PUBLIC_SPREAD_NGN_PER_USD=10

# ── Optional: monitoring ────────────────────────────────────────────
# Sentry DSN. Unset means crash reporting is disabled and errors stay in the
# console, which is what you want locally.
# EXPO_PUBLIC_SENTRY_DSN=
